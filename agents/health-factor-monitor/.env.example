BSC_RPC_URL=https://bsc-dataseed.binance.org
POLL_INTERVAL_MS=60000
LOW_BUFFER_USD=50

# Pull monitored wallets from Roster automatically (recommended):
ROSTER_API_URL=http://localhost:4000
ROSTER_AGENT_ID=

# Or run fully standalone, no Roster dependency at all:
MONITORED_WALLETS=

# Optional: POST alerts here (e.g. a Slack incoming webhook)
ALERT_WEBHOOK_URL=
